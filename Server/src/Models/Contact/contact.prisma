model Contact {
    id          String   @id @default(uuid()) @db.Uuid
    userId      String   @db.Uuid
    contactedId String   @db.Uuid
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    user      User @relation("ContactOwner", fields: [userId], references: [id], onDelete: Cascade)
    contacted User @relation("ContactedUser", fields: [contactedId], references: [id], onDelete: Cascade)

    @@unique([userId, contactedId])
    @@index([userId])
    @@index([contactedId])
    @@map("contacts")
}
