enum CallType {
    AUDIO @map("audio")
    VIDEO @map("video")
}

enum CallStatus {
    MISSED    @map("missed")
    COMPLETED @map("completed")
    REJECTED  @map("rejected")
}

model CallLog {
    id             String     @id @default(uuid()) @db.Uuid
    conversationId String     @db.Uuid
    callerId       String     @db.Uuid
    receiverId     String     @db.Uuid
    type           CallType
    startedAt      DateTime   @default(now())
    endedAt        DateTime?
    duration       Int        @default(0)
    status         CallStatus
    createdAt      DateTime   @default(now())
    updatedAt      DateTime   @updatedAt

    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    caller       User         @relation("Caller", fields: [callerId], references: [id], onDelete: Cascade)
    receiver     User         @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

    @@index([callerId, startedAt(sort: Desc)])
    @@index([receiverId, startedAt(sort: Desc)])
    @@index([conversationId, startedAt(sort: Desc)])
    @@map("call_logs")
}
