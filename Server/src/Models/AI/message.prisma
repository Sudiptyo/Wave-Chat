enum AiMessageRole {
  AI   @map("ai")
  USER @map("user")
}

enum AiContentType {
  TEXT  @map("text")
  IMAGE @map("image")
  FILE  @map("file")
}

model AiMessage {
  id          String        @id @default(uuid()) @db.Uuid
  chatId      String        @db.Uuid
  role        AiMessageRole
  content     String        @db.VarChar(5000)
  contentType AiContentType @default(TEXT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  chat AiChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt(sort: Desc)])
  @@map("ai_messages")
}
